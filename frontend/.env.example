# Copy this file to .env.local and fill in the values below.
# Do NOT commit .env.local — it is gitignored.

# GenLayer network to target: "studionet" (default) or "localnet".
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# RPC endpoint for the GenLayer network.
#   StudioNet: https://studio.genlayer.com/api   (chain ID 61999 / 0xf22f)
#   Localnet:  http://127.0.0.1:4000/api         (chain ID 61127 / 0xeec7)
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Deployed MilestoneJudge contract address.
# Preserve the exact casing — StudioNet resolves addresses by literal string.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Optional: API key for the LLM gateway used by the local glsim simulator.
# Only needed when running scripts/run_glsim.py. Never commit a real value.
OPENAI_API_KEY=
